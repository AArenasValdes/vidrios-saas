{
  "name": "vidrios-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/stub-next-polyfill-module.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e:auth-mobile": "playwright test tests/e2e/auth-logout.mobile.spec.ts --project=mobile-chromium",
    "test:e2e:list": "playwright test --list",
    "test:watch": "jest --watch",
    "pilot:user:audit": "node scripts/pilot-users.mjs audit",
    "pilot:user:create": "node scripts/pilot-users.mjs create",
    "pilot:user:repair": "node scripts/pilot-users.mjs repair",
    "pilot:user:reset-password": "node scripts/pilot-users.mjs reset-password",
    "pilot:org:provision": "node scripts/pilot-org-provision.mjs provision",
    "pilot:org:audit-trials": "node scripts/pilot-org-provision.mjs audit-trials",
    "pilot:org:fix-trials": "node scripts/pilot-org-provision.mjs fix-trials",
    "pilot:payment:activate": "node scripts/pilot-payment-activate.mjs",
    "pilot:trial:extend": "node scripts/pilot-trial-extend.mjs",
    "video:preview": "remotion preview remotion/index.tsx",
    "video:render": "remotion render remotion/index.tsx VentoraExplainer out/ventora-explainer-16x9.mp4",
    "video:render:vertical": "remotion render remotion/index.tsx VentoraExplainerVertical out/ventora-explainer-9x16.mp4",
    "video:capture-demo-assets": "node --experimental-strip-types scripts/capture-ventora-demo-assets.ts",
    "video:preview:demo-master": "remotion preview remotion/index.tsx --props='{}' --initial-composition=VentoraDemoMasterVertical",
    "video:render:demo-master": "remotion render remotion/index.tsx VentoraDemoMasterVertical out/ventora-demo-master-vertical.mp4 --concurrency=1 --crf=28",
    "push:vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@remotion/cli": "^4.0.459",
    "@remotion/player": "^4.0.459",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-qr-code": "^2.0.21",
    "remotion": "^4.0.459",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "supabase": "^2.98.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
